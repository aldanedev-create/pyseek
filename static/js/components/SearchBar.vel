<template><div class="search-wrap"><form class="search-form" @submit="submit"><span class="search-icon">⌕</span><input placeholder="Search the indexed web" aria-label="Search" autofocus /><button type="submit">Search</button></form><div v-if="suggestions && suggestions.length" class="suggestions"><button v-for="item in suggestions" :key="item" @click="$emit('choose', item)">{{ item }}</button></div></div></template>
<script>export default { props: { query: String, suggestions: Array, loading: Boolean }, methods: { submit(event) { event.preventDefault(); const input = event.currentTarget.querySelector('input'); this.$emit('search', input ? input.value : '') } } }</script>
