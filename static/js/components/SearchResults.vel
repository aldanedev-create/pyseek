<script>import ResultCard from './ResultCard.vel'; export default { components: { ResultCard }, props: { results: Array, query: String } }</script>
<template><div :hidden="!(results && results.length)" class="result-list"><p class="result-meta">{{ results.length }} result<span v-if="results.length !== 1">s</span> for “{{ query }}”</p><ResultCard v-for="result in results" :key="result.id || result.url" :result="result" /></div></template>
