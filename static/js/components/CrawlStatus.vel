<template><section class="side-card status-card"><div class="side-heading"><h2>Index status</h2><button class="text-button" @click="$emit('refresh')">Refresh</button></div><div class="stat"><strong>{{ stats.documents || 0 }}</strong><span>pages indexed</span></div><div class="stat-row"><span>Queued</span><b>{{ stats.queued || 0 }}</b></div><div class="stat-row"><span>Failed</span><b>{{ stats.failed || 0 }}</b></div><p class="muted">PySeek crawls only seeded sites, obeys robots.txt, and uses bounded batches.</p></section></template>
<script>export default { props: { stats: Object } }</script>
